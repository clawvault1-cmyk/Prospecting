# Shared password for the web app. Required. Use a long random value.
APP_PASSWORD=change-me

# Signs the session cookie. Defaults to APP_PASSWORD if empty.
APP_SECRET=

# SQLite directory. On Render, point this at a persistent disk.
DATA_DIR=data

# auto uses a live provider when its key is present, otherwise mock.
# Set both to mock to force the offline demo even if keys are exported.
LLM_PROVIDER=auto
SEARCH_PROVIDER=auto

# OpenAI-compatible chat. For xAI use https://api.x.ai/v1 and a Grok model id.
# For OpenAI leave the base URL and set a model such as gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Set to false if the endpoint rejects response_format.
OPENAI_JSON_MODE=true

# Used when LLM_PROVIDER=anthropic (or auto, if this key is set and OPENAI_API_KEY is empty).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Tavily web search. https://tavily.com
TAVILY_API_KEY=

# 1 runs each company inside the web request (useful in tests). Leave unset in production.
JOBS_SYNC=
HTTP_TIMEOUT=45
